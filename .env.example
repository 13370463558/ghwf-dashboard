# 容器部署环境变量
# 两种方式任选其一：
#   方式 A：在容器面板的 Environment 里配置（如果支持）
#   方式 B：手动把本文件复制为 .env 放到 /home/container/.env（容器无法设置环境变量时用这个）
#           server.js 启动时会自动读取同目录的 .env
#
# 注意：.env 已在 .gitignore，不会提交进 git，避免泄露 GITHUB_TOKEN。

# GitHub classic token：最小权限（私有仓库用 repo，只看公开用 public_repo）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 登录密码（单账户）
APP_PASSWORD=change-me

# cookie 签名密钥（openssl rand -hex 32 生成）
AUTH_SECRET=change-me-too

# 端口（容器一般自动注入 PORT；没有则默认 8080）
# PORT=8080

# ---- 调度器（可选，准点触发时用）----
# dispatch 后延时多少秒去查 GitHub runs 确认入队（默认 15）
# SCHED_CONFIRM_DELAY=15
# dispatch 最大尝试次数（默认 3，含首次；超过则发 TG 通知）
# SCHED_MAX_RETRIES=3

# ---- 调度表异地备份（强烈建议配置）----
# 调度表存容器本地 data/kv.json，容器重装/磁盘损坏会全灭（被接管仓库的 YAML
# schedule 已注释掉，丢了调度表 = 所有续期任务静默中断）。
# 配置后每次调度变化 + 每日自动把调度表备份成 JSON 提交到指定仓库；
# 恢复：GET /api/scheduler?restore=1 或把备份 JSON 的 state 字段手动写回。
# 格式 'owner/repo'（需 GITHUB_TOKEN 有该仓库写权限，建议就放 ghwf-dashboard 仓库）
# SCHED_BACKUP_REPO=yourname/ghwf-dashboard
# 备份文件路径（默认 data/scheduler-state.backup.json）
# SCHED_BACKUP_PATH=data/scheduler-state.backup.json
# 分支（默认 main）
# SCHED_BACKUP_BRANCH=main

# ---- Telegram 通知（可选，调度触发最终失败时通知）----
# 机器人 token（找 @BotFather 创建，@userinfobot 查你的 chat_id）
TG_BOT_TOKEN=123456:ABC-DEF...
TG_CHAT_ID=你的数字chat_id