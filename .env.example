# 容器部署环境变量
# 两种方式任选其一：
#   方式 A：在容器面板的 Environment 里配置（如果支持）
#   方式 B：手动把本文件复制为 .env 放到 /home/container/.env（容器无法设置环境变量时用这个）
#           server.js 启动时会自动读取同目录的 .env
#
# 注意：.env 已在 .gitignore，不会提交进 git，避免泄露 GITHUB_TOKEN。

# GitHub classic token：最小权限（私有仓库用 repo，只看公开用 public_repo）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 登录密码（单账户）
APP_PASSWORD=change-me

# cookie 签名密钥（openssl rand -hex 32 生成）
AUTH_SECRET=change-me-too

# 端口（容器一般自动注入 PORT；没有则默认 8080）
# PORT=8080