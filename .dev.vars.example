# 本地开发环境变量（复制为 .dev.vars 并填写真实值，.dev.vars 已 gitignore）
# 生产环境在 Cloudflare Dashboard → Pages 项目 → Settings → Environment variables 配置同样的三个变量

# GitHub classic token：最小权限（私有仓库用 repo，只看公开用 public_repo）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 登录密码（单账户）
APP_PASSWORD=change-me

# cookie 签名密钥（任意长随机串，建议 openssl rand -hex 32）
AUTH_SECRET=change-me-too
